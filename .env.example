# ============================================================
# BESTEHENDE VARIABLEN (nicht löschen!)
# ============================================================

# Geschützter Expertise-Bereich (reiner Lesezugang)
ADMIN_USER=EXPERTISE_BENUTZERNAME
ADMIN_PASS=SICHERES_EINZIGARTIGES_PASSWORT

# HMAC-Session-Signatur (mindestens 32 zufällige Zeichen)
SESSION_SECRET=ZUFAELLIGER_LANGER_STRING_MIN_32_ZEICHEN

# ============================================================
# SUPABASE
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============================================================
# RESEND
# ============================================================

RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=kontakt@example.com

# ============================================================
# RECRUITER AUTH
# ============================================================

RECRUITER_PASSWORD=SICHERES_EINZIGARTIGES_PASSWORT
RECRUITER_SESSION_SECRET=ZUFAELLIGER_LANGER_STRING_MIN_32_ZEICHEN

# ============================================================
# KI / ANTHROPIC
# ============================================================

ANTHROPIC_API_KEY=sk-ant-...

# ============================================================
# ALLGEMEIN
# ============================================================

