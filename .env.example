# ============================================================
# BESTEHENDE VARIABLEN (nicht löschen!)
# ============================================================

# Geschützter Expertise-Bereich (reiner Lesezugang)
ADMIN_USER=EXPERTISE_BENUTZERNAME
ADMIN_PASS=SICHERES_EINZIGARTIGES_PASSWORT

# HMAC-Session-Signatur (mindestens 32 zufällige Zeichen)
SESSION_SECRET=ZUFAELLIGER_LANGER_STRING_MIN_32_ZEICHEN

# ============================================================
# SUPABASE
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============================================================
# RESEND
# ============================================================

RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=kontakt@example.com

# ============================================================
# RECRUITER AUTH
# ============================================================

RECRUITER_PASSWORD=SICHERES_EINZIGARTIGES_PASSWORT
RECRUITER_SESSION_SECRET=ZUFAELLIGER_LANGER_STRING_MIN_32_ZEICHEN

# Nur diese E-Mail-Adresse soll das Supabase-Dashboard verwenden.
# Registrierung in Supabase deaktiviert lassen und MFA im Supabase-Konto aktivieren.
DASHBOARD_ADMIN_EMAIL=marcel@example.com

# ============================================================
# KI / OPENAI
# ============================================================

OPENAI_API_KEY=sk-proj-...
OPENAI_AILA_MODEL=gpt-5.6-terra
OPENAI_AILA_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_AILA_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_AILA_TTS_MODEL=gpt-4o-mini-tts
OPENAI_AILA_VOICE=marin

# ============================================================
# ALLGEMEIN
# ============================================================

NEXT_PUBLIC_SITE_URL=https://www.example.com
PORT=3000
